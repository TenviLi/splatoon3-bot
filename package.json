{
  "name": "splatoon3-bot",
  "version": "2.0.0",
  "description": "Splatoon 3 Bot",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11.18.0 <12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "pnpm run check:syntax && pnpm run test:unit && pnpm run build",
    "check:syntax": "find bot scripts src -type f \\( -name '*.js' -o -name '*.mjs' \\) -print0 | xargs -0 -n1 node --check",
    "verify": "node bot/verification/index.mjs",
    "test": "pnpm run test:unit && pnpm run test:visual",
    "test:unit": "node --test tests/run-plan.test.mjs tests/run-manifest.test.mjs tests/data-snapshot.test.mjs tests/notification-channels.test.mjs tests/notification-delivery.test.mjs tests/upyun-publisher.test.mjs",
    "test:visual": "node --test tests/screenshot-visual.test.mjs",
    "test:update-golden": "node tests/generate-screenshot-goldens.mjs",
    "test:localize-fixture": "node tests/localize-fixture-assets.mjs",
    "preview": "vite preview --port 5050",
    "download-data": "node scripts/download_data.mjs",
    "bot:describe": "node bot/run/describe.mjs",
    "bot:prepare": "node bot/run/prepare.mjs",
    "bot:publish": "node bot/publish/index.mjs",
    "bot:notify": "node bot/notification/index.mjs",
    "start:schedules": "node bot/screenshot/index.mjs schedules",
    "start:salmon-run": "node bot/screenshot/index.mjs salmon-run",
    "start:gear": "node bot/screenshot/index.mjs gear",
    "send-message:schedules": "node bot/notification/index.mjs schedules wecom",
    "send-message:salmon-run": "node bot/notification/index.mjs salmon-run wecom",
    "send-message:gear": "node bot/notification/index.mjs gear wecom"
  },
  "keywords": [],
  "author": "tenvili",
  "license": "ISC",
  "dependencies": {
    "@headlessui/vue": "1.7.23",
    "@heroicons/vue": "2.2.0",
    "@vue/devtools-api": "8.2.1",
    "pinia": "4.0.2",
    "puppeteer-core": "25.4.0",
    "sirv": "3.0.2",
    "vue": "3.5.40",
    "vue-i18n": "11.4.8",
    "vue-router": "5.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "11.2.4",
    "@puppeteer/browsers": "^3.0.6",
    "@tailwindcss/postcss": "4.3.3",
    "@vitejs/plugin-vue": "6.0.8",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "postcss": "8.5.25",
    "tailwindcss": "4.3.3",
    "vite": "8.1.5"
  }
}
